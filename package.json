{
  "name": "confusion-cypress",
  "version": "1.0.0",
  "description": "Cypress project with Cucumber for conFusion test site",
  "scripts": {
    "cypress": "cypress open",
    "install-webkit": "playwright install webkit",
    "cy:chrome": "cross-env ALLURE_LABEL_browser=Chrome cypress run --browser chrome",
    "cy:firefox": "cross-env ALLURE_LABEL_browser=Firefox cypress run --browser firefox",
    "cy:webkit": "cross-env ALLURE_LABEL_browser=WebKit cypress run --browser webkit",
    "cy:run-all": "run-s --continue-on-error cy:chrome cy:firefox cy:webkit",
    "allure:clean": "rimraf allure-report",
    "allure-report": "npm run allure:clean && allure generate ./allure-results --output ./allure-report"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-cypress": "3.15.0",
    "cross-env": "^10.1.0",
    "cypress": "16.3.0",
    "esbuild": "0.28.2",
    "npm-run-all": "^4.1.5",
    "playwright-webkit": "1.65.1",
    "rimraf": "^6.1.4"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/common/common.{js,ts}",
      "cypress/e2e/features/**/*.{js,ts}"
    ]
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "cypress@16.3.0": true,
    "esbuild@0.28.2": true,
    "playwright-webkit@1.65.1": true
  }
}
